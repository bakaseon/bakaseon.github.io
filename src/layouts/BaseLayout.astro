---
import '../styles/global.css';
import { SITE_CONFIG } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  jsonLd?: Record<string, any>;
}

const {
  title = SITE_CONFIG.title,
  description = SITE_CONFIG.description,
  canonicalURL = new URL(Astro.url.pathname, SITE_CONFIG.url).toString(),
  jsonLd
} = Astro.props;

const fullTitle = title === SITE_CONFIG.title ? title : `${title} | ${SITE_CONFIG.shortName}`;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={SITE_CONFIG.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / SNS 공유 최적화 -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE_CONFIG.title} />

    <!-- 구글 서치콘솔 & 네이버 서치어드바이저 소유권 확인 -->
    {SITE_CONFIG.verification.google && (
      <meta name="google-site-verification" content={SITE_CONFIG.verification.google} />
    )}
    {SITE_CONFIG.verification.naver && (
      <meta name="naver-site-verification" content={SITE_CONFIG.verification.naver} />
    )}

    <!-- Google AdSense 자동 스크립트 (ID 설정 시 자동 활성화) -->
    {SITE_CONFIG.ads.googleAdSenseId && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE_CONFIG.ads.googleAdSenseId}`}
        crossorigin="anonymous"
      ></script>
    )}

    <!-- 구글 리치 스니펫(JSON-LD) 구조화 데이터 -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">
          <span class="brand-badge">PRO</span>
          <span>{SITE_CONFIG.shortName}</span>
        </a>
        <nav aria-label="주요 메뉴">
          <ul class="nav-list">
            {SITE_CONFIG.navLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class={`nav-link ${currentPath === item.href ? 'active' : ''}`}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main class="container" style="padding-top: 1.5rem; min-height: 75vh;">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-links">
          <a href="/about/">사이트 소개 (About)</a>
          <a href="/privacy/">개인정보처리방침 (Privacy Policy)</a>
          <a href="/terms/">이용약관 (Terms of Service)</a>
          <a href="/contact/">문의하기 (Contact)</a>
          <a href="/sitemap.xml">사이트맵 (Sitemap)</a>
        </div>
        <p>© {new Date().getFullYear()} {SITE_CONFIG.title}. All rights reserved.</p>
        <p style="margin-top: 0.4rem; font-size: 0.8rem;">
          본 사이트의 모든 계산 결과 및 정보는 참고용이며 법적·금융적 효력을 갖지 않습니다. 정확한 세액 및 금융 조건은 관련 기관에 확인하시기 바랍니다.
        </p>
      </div>
    </footer>
  </body>
</html>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import AffiliateCard from '../../components/AffiliateCard.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "해외직구 관부가세 자동 계산기 (2026 최신 관세청 기준)",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All",
  "description": "미국 직구 200달러, 기타 국가 150달러 면세 한도 및 품목별 관세·부가세를 1초 만에 계산합니다."
};
---

<BaseLayout
  title="해외직구 관부가세 계산기 (2026 미국 $200·중국/일본 $150 면세기준)"
  description="알리익스프레스, 아마존, 아이허브 직구 전 필수! 구매 국가, 물품 가격, 품목만 선택하면 면세 여부와 예상 관세·부가세를 실시간으로 계산해 드립니다."
  jsonLd={jsonLd}
>
  <AdSlot position="top" />

  <div class="card">
    <h1 style="font-size: 1.65rem; margin-bottom: 0.5rem;">📦 해외직구 관부가세 자동 계산기</h1>
    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
      구매 국가(미국 목록통관 $200 / 기타 국가 $150)와 품목별 세율을 자동 반영하여 예상 세금과 총 결제 금액을 계산합니다.
    </p>

    <div class="grid-2">
      <div>
        <div class="form-group">
          <label for="country">1. 구매 국가 (발송국)</label>
          <select id="country" class="form-control">
            <option value="US">미국 (목록통관 $200 이하 면세)</option>
            <option value="CN">중국 - 알리/타오바오 ($150 이하 면세)</option>
            <option value="JP">일본 ($150 이하 면세)</option>
            <option value="EU">유럽/영국 ($150 이하 면세)</option>
          </select>
        </div>

        <div class="form-group">
          <label for="category">2. 품목 카테고리</label>
          <select id="category" class="form-control">
            <option value="elec" data-duty="0" data-general="false">노트북 · 스마트폰 · PC부품 (관세 0%, 부가세 10%)</option>
            <option value="apparel" data-duty="0.13" data-general="false">의류 · 신발 · 패션잡화 (관세 13%, 부가세 10%)</option>
            <option value="health" data-duty="0.08" data-general="true">영양제 · 건강기능식품 (일반통관 $150 기준, 관세 8%)</option>
            <option value="cosmetic" data-duty="0.065" data-general="false">화장품 · 향수 (관세 6.5%, 부가세 10%)</option>
            <option value="general" data-duty="0.08" data-general="false">기타 생활용품 · 완구 · 소형가전 (관세 8%, 부가세 10%)</option>
          </select>
        </div>

        <div class="form-group">
          <label for="priceUsd">3. 물품 총 결제금액 (현지 배송비 포함, USD 달러 기준)</label>
          <input type="number" id="priceUsd" class="form-control" value="220" min="1" step="1" />
        </div>

        <div class="form-group">
          <label for="exchangeRate">4. 적용 환율 (원/USD, 기본 고시환율)</label>
          <input type="number" id="exchangeRate" class="form-control" value="1380" min="900" step="10" />
        </div>

        <button id="calcBtn" class="btn-primary" type="button">관부가세 즉시 계산하기</button>
      </div>

      <div>
        <div class="result-box" id="resultBox">
          <div style="font-size: 0.9rem; font-weight: 700; color: var(--primary);" id="taxStatusBadge">계산 결과</div>
          <div class="result-highlight" id="totalTaxText">₩0</div>
          <p id="statusDesc" style="font-size: 0.92rem; color: var(--text-muted); margin-bottom: 1rem;">
            금액을 입력하면 면세 한도 초과 여부와 예상 세금이 표시됩니다.
          </p>

          <hr style="border: none; border-top: 1px solid #bfdbfe; margin: 1rem 0;" />

          <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
            <span>물품 원화 환산액:</span>
            <strong id="krwPrice">₩0</strong>
          </div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
            <span>예상 관세:</span>
            <strong id="dutyAmount">₩0</strong>
          </div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
            <span>예상 부가가치세 (10%):</span>
            <strong id="vatAmount">₩0</strong>
          </div>
          <div style="display: flex; justify-content: space-between; font-size: 1.08rem; padding-top: 0.5rem; border-top: 1px dashed #93c5fd;">
            <span><strong>최종 예상 총 지출액:</strong></span>
            <strong id="grandTotal" style="color: var(--primary-dark);">₩0</strong>
          </div>
        </div>

        <AffiliateCard type="customs" />
      </div>
    </div>
  </div>

  <AdSlot position="middle" />

  <article class="card prose">
    <h2>2026년 해외직구 면세 한도 및 통관 완벽 가이드</h2>
    <p>
      해외직구 시 가장 많이 실수하는 부분이 <strong>목록통관($200)</strong>과 <strong>일반통관($150)</strong>의 차이를 혼동하여 예상치 못한 관부가세를 납부하는 것입니다. 아래 기준표를 확인하면 세금 폭탄을 피할 수 있습니다.
    </p>
    <table>
      <thead>
        <tr>
          <th>발송 국가</th>
          <th>통관 구분</th>
          <th>면세 한도 (USD)</th>
          <th>주요 주의사항</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>미국 (USA)</strong></td>
          <td>목록통관 품목</td>
          <td><strong>$200 이하</strong></td>
          <td>의류, 신발, 전자기기 등 일반 공산품 해당</td>
        </tr>
        <tr>
          <td><strong>미국 (USA)</strong></td>
          <td>일반통관 품목</td>
          <td><strong>$150 이하</strong></td>
          <td>영양제(최대 6병), 의약품, 식품류는 미국발이라도 $150 적용</td>
        </tr>
        <tr>
          <td><strong>중국 · 일본 · 유럽 등</strong></td>
          <td>전 품목 공통</td>
          <td><strong>$150 이하</strong></td>
          <td>알리익스프레스, 타오바오, 아마존 재팬 등 모두 미화 $150 기준</td>
        </tr>
      </tbody>
    </table>

    <h3>💡 직구족이 꼭 알아야 할 절세 팁 3가지</h3>
    <ul>
      <li><strong>합산과세 주의:</strong> 서로 다른 날에 주문했더라도 한국 입항일이 같고 발송국이 같으면 금액이 합산되어 과세될 수 있습니다. 입항 완료 후 다음 주문을 진행하세요.</li>
      <li><strong>영양제 6병 제한:</strong> 건강기능식품은 금액이 $150 이하라도 1회 통관 시 최대 6병까지만 자가사용 면세가 인정됩니다.</li>
      <li><strong>전자제품 전파인증 면제:</strong> 개인 사용 목적의 노트북, 스마트폰, 태블릿 등은 모델별 1대까지 전파인증이 면제되며 관세는 0%(부가세 10%만 부과)입니다.</li>
    </ul>
  </article>

  <AdSlot position="bottom" />

  <script is:inline>
    function calculateCustoms() {
      const country = document.getElementById('country').value;
      const catSelect = document.getElementById('category');
      const selectedOpt = catSelect.options[catSelect.selectedIndex];
      const dutyRate = parseFloat(selectedOpt.getAttribute('data-duty') || '0.08');
      const isGeneralClearance = selectedOpt.getAttribute('data-general') === 'true';

      const priceUsd = parseFloat(document.getElementById('priceUsd').value) || 0;
      const rate = parseFloat(document.getElementById('exchangeRate').value) || 1380;

      // 면세 한도 결정: 미국이면서 목록통관 품목이면 $200, 그 외엔 $150
      const limitUsd = (country === 'US' && !isGeneralClearance) ? 200 : 150;
      const krwPrice = Math.round(priceUsd * rate);

      let duty = 0;
      let vat = 0;

      if (priceUsd > limitUsd) {
        // 과세 표준 (간이 선편 요금 약 1만원 가산 근사치 반영)
        const taxableBase = krwPrice + 10000;
        duty = Math.round(taxableBase * dutyRate);
        vat = Math.round((taxableBase + duty) * 0.10);
      }

      const totalTax = duty + vat;
      const grandTotal = krwPrice + totalTax;

      const fmt = (n) => '₩' + n.toLocaleString('ko-KR');

      document.getElementById('krwPrice').textContent = fmt(krwPrice);
      document.getElementById('dutyAmount').textContent = fmt(duty);
      document.getElementById('vatAmount').textContent = fmt(vat);
      document.getElementById('totalTaxText').textContent = fmt(totalTax);
      document.getElementById('grandTotal').textContent = fmt(grandTotal);

      const badge = document.getElementById('taxStatusBadge');
      const desc = document.getElementById('statusDesc');

      if (priceUsd <= limitUsd) {
        badge.textContent = `✅ 면세 대상 (한도 $${limitUsd} 이하)`;
        badge.style.color = '#059669';
        desc.textContent = `면세 한도($${limitUsd}) 이내이므로 관부가세가 부과되지 않습니다.`;
      } else {
        badge.textContent = `⚠️ 과세 대상 (한도 $${limitUsd} 초과)`;
        badge.style.color = '#dc2626';
        desc.textContent = `면세 한도를 $${(priceUsd - limitUsd).toFixed(1)} 초과하여 전체 금액에 대해 세금이 부과됩니다.`;
      }
    }

    document.getElementById('calcBtn').addEventListener('click', calculateCustoms);
    ['country', 'category', 'priceUsd', 'exchangeRate'].forEach((id) => {
      document.getElementById(id).addEventListener('input', calculateCustoms);
    });
    calculateCustoms();
  </script>
</BaseLayout>

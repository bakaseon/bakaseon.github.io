---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import AffiliateCard from '../../components/AffiliateCard.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "2026 연봉 실수령액 계산기 (연금개혁 4.75% · 건보 3.595% 최신 반영)",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All",
  "description": "2026년 인상된 국민연금(4.75%), 건강보험(3.595%), 장기요양보험(13.14%) 및 최저임금(시급 10,320원) 기준을 완벽 반영한 세후 월급 실수령액 계산기입니다."
};
---

<BaseLayout
  title="2026 연봉 실수령액 계산기 (국민연금 4.75%·건보 3.595% 인상분 최신 반영)"
  description="2026년 연금개혁 및 건강보험료율 인상으로 내 실수령액은 어떻게 바뀌었을까요? 국민연금 4.75%(상한 659만원), 건강보험 3.595%, 장기요양 13.14%, 비과세 식대(20만원)를 완벽 반영해 계산합니다."
  jsonLd={jsonLd}
>
  <AdSlot position="top" />

  <div class="card">
    <h1 style="font-size: 1.65rem; margin-bottom: 0.5rem;">💰 2026 연봉 실수령액 자동 계산기 (최신 인상 요율 반영)</h1>
    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
      2026년 개정된 <strong>국민연금(근로자 4.75% · 상한 659만원)</strong>, <strong>건강보험(3.595%)</strong>, <strong>장기요양보험(건보료의 13.14%)</strong> 최신 요율을 적용하여 실제 통장 입금액을 계산합니다.
    </p>

    <div class="grid-2">
      <div>
        <div class="form-group">
          <label for="annualSalary">1. 계약 연봉 (만원 단위, 2026 최저연봉 약 2,588만원)</label>
          <input type="number" id="annualSalary" class="form-control" value="5000" min="2000" step="100" />
        </div>

        <div class="form-group">
          <label for="nonTaxable">2. 월 비과세액 (식대 등, 법정 한도 월 20만원)</label>
          <input type="number" id="nonTaxable" class="form-control" value="20" min="0" step="5" />
        </div>

        <div class="form-group">
          <label for="dependents">3. 부양가족 수 (본인 포함)</label>
          <select id="dependents" class="form-control">
            <option value="1">1명 (본인만)</option>
            <option value="2">2명</option>
            <option value="3">3명</option>
            <option value="4">4명 이상</option>
          </select>
        </div>

        <button id="calcSalaryBtn" class="btn-primary" type="button">2026 최신 요율로 실수령액 계산하기</button>
      </div>

      <div>
        <div class="result-box">
          <div style="font-size: 0.9rem; font-weight: 700; color: var(--primary);">2026 예상 월 실수령액 (세후)</div>
          <div class="result-highlight" id="netMonthlyText">₩0</div>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1rem;">
            세전 월급 <strong id="grossMonthlyText">₩0</strong>에서 총 <strong id="totalDeductionText" style="color:#dc2626;">₩0</strong>이 공제됩니다.
          </p>

          <hr style="border: none; border-top: 1px solid #bfdbfe; margin: 1rem 0;" />

          <div style="display: flex; justify-content: space-between; margin-bottom: 0.4rem; font-size: 0.92rem;">
            <span>국민연금 (4.75%, 상한 659만원):</span>
            <strong id="pensionText">₩0</strong>
          </div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 0.4rem; font-size: 0.92rem;">
            <span>건강보험 (3.595%) + 장기요양 (13.14%):</span>
            <strong id="healthText">₩0</strong>
          </div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 0.4rem; font-size: 0.92rem;">
            <span>고용보험 (0.9%):</span>
            <strong id="employText">₩0</strong>
          </div>
          <div style="display: flex; justify-content: space-between; font-size: 0.92rem;">
            <span>근로소득세 + 지방소득세:</span>
            <strong id="taxText">₩0</strong>
          </div>
        </div>

        <AffiliateCard type="salary" />
      </div>
    </div>
  </div>

  <AdSlot position="middle" />

  <article class="card prose">
    <h2>2026년 4대 보험료율 인상 핵심 요약 및 연봉별 실수령액표</h2>
    <p>
      2026년부터는 국민연금 개혁안 시행에 따라 국민연금 보험료율이 기존 9.0%에서 <strong>9.5%(근로자 부담분 4.75%)</strong>로 인상되었으며, 건강보험료율 또한 <strong>7.19%(근로자 3.595%)</strong>, 장기요양보험료율은 건보료의 <strong>13.14%</strong>로 상향 조정되었습니다.
    </p>
    <table>
      <thead>
        <tr>
          <th>구분</th>
          <th>2025년 기존 근로자 요율</th>
          <th><strong>2026년 최신 근로자 요율</strong></th>
          <th>주요 변경 사항</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>국민연금</strong></td>
          <td>4.50%</td>
          <td><strong>4.75% (+0.25%p)</strong></td>
          <td>기준소득월액 상한 <strong>659만 원</strong> (최대 월 313,025원) / 하한 41만 원</td>
        </tr>
        <tr>
          <td><strong>건강보험</strong></td>
          <td>3.545%</td>
          <td><strong>3.595% (+0.05%p)</strong></td>
          <td>총 요율 7.09% ➔ 7.19% 인상 (노사 50%씩 부담)</td>
        </tr>
        <tr>
          <td><strong>장기요양보험</strong></td>
          <td>건보료의 12.95%</td>
          <td><strong>건보료의 13.14%</strong></td>
          <td>소득 대비 약 0.4724% 근로자 부담</td>
        </tr>
        <tr>
          <td><strong>고용보험</strong></td>
          <td>0.90%</td>
          <td><strong>0.90% (동결)</strong></td>
          <td>2026 최저임금 시급 <strong>10,320원</strong> (월 2,156,880원) 적용</td>
        </tr>
      </tbody>
    </table>

    <h3>2026년 연봉 구간별 세후 월 실수령액 요약표 (비과세 20만 원 기준)</h3>
    <table>
      <thead>
        <tr>
          <th>세전 연봉</th>
          <th>세전 월급</th>
          <th>4대보험 + 세금 공제액(약)</th>
          <th>2026 예상 월 실수령액</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>2,588만 원 (최저연봉)</strong></td>
          <td>약 215.7만 원</td>
          <td>약 20.6만 원</td>
          <td><strong>약 195.1만 원</strong></td>
        </tr>
        <tr>
          <td><strong>3,000만 원</strong></td>
          <td>250만 원</td>
          <td>약 26.8만 원</td>
          <td><strong>약 223.2만 원</strong></td>
        </tr>
        <tr>
          <td><strong>4,000만 원</strong></td>
          <td>333.3만 원</td>
          <td>약 41.2만 원</td>
          <td><strong>약 292.1만 원</strong></td>
        </tr>
        <tr>
          <td><strong>5,000만 원</strong></td>
          <td>416.6만 원</td>
          <td>약 59.5만 원</td>
          <td><strong>약 357.1만 원</strong></td>
        </tr>
        <tr>
          <td><strong>6,000만 원</strong></td>
          <td>500만 원</td>
          <td>약 79.8만 원</td>
          <td><strong>약 420.2만 원</strong></td>
        </tr>
        <tr>
          <td><strong>8,000만 원</strong></td>
          <td>666.6만 원</td>
          <td>약 126.5만 원</td>
          <td><strong>약 540.1만 원</strong></td>
        </tr>
        <tr>
          <td><strong>1억 원</strong></td>
          <td>833.3만 원</td>
          <td>약 180.5만 원</td>
          <td><strong>약 652.8만 원</strong></td>
        </tr>
      </tbody>
    </table>
  </article>

  <AdSlot position="bottom" />

  <script is:inline>
    function calcSalary() {
      const annualMan = parseFloat(document.getElementById('annualSalary').value) || 5000;
      const nonTaxMan = parseFloat(document.getElementById('nonTaxable').value) || 20;
      const dep = parseInt(document.getElementById('dependents').value, 10) || 1;

      const grossMonthly = Math.round((annualMan * 10000) / 12);
      const nonTax = Math.round(nonTaxMan * 10000);
      const taxableMonthly = Math.max(0, grossMonthly - nonTax);

      // 2026 국민연금: 근로자 4.75%, 기준소득월액 하한 410,000원 ~ 상한 6,590,000원
      const pensionBase = Math.min(Math.max(taxableMonthly, 410000), 6590000);
      const pension = taxableMonthly > 0 ? Math.round(pensionBase * 0.0475) : 0;

      // 2026 건강보험 (3.595%) + 장기요양보험 (건보료의 13.14%)
      const health = Math.round(taxableMonthly * 0.03595);
      const longTermCare = Math.round(health * 0.1314);
      const totalHealth = health + longTermCare;

      // 2026 고용보험 (0.9%)
      const employ = Math.round(taxableMonthly * 0.009);

      // 간이세액표 기반 근로소득세 근사 산출
      let incomeTax = 0;
      if (taxableMonthly > 1500000) {
        const excess = taxableMonthly - 1500000;
        const rate = taxableMonthly > 5000000 ? 0.11 : taxableMonthly > 3500000 ? 0.075 : 0.04;
        incomeTax = Math.round(excess * rate * Math.max(0.6, 1 - (dep - 1) * 0.12));
      }
      const localTax = Math.round(incomeTax * 0.1);
      const totalTax = incomeTax + localTax;

      const totalDeduction = pension + totalHealth + employ + totalTax;
      const netMonthly = grossMonthly - totalDeduction;

      const fmt = (n) => '₩' + n.toLocaleString('ko-KR');

      document.getElementById('grossMonthlyText').textContent = fmt(grossMonthly);
      document.getElementById('totalDeductionText').textContent = fmt(totalDeduction);
      document.getElementById('netMonthlyText').textContent = fmt(netMonthly);
      document.getElementById('pensionText').textContent = fmt(pension);
      document.getElementById('healthText').textContent = fmt(totalHealth);
      document.getElementById('employText').textContent = fmt(employ);
      document.getElementById('taxText').textContent = fmt(totalTax);
    }

    document.getElementById('calcSalaryBtn').addEventListener('click', calcSalary);
    ['annualSalary', 'nonTaxable', 'dependents'].forEach((id) => {
      document.getElementById(id).addEventListener('input', calcSalary);
    });
    calcSalary();
  </script>
</BaseLayout>

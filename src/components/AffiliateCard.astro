---
import { SITE_CONFIG } from '../config/site';

interface Props {
  type?: 'customs' | 'salary' | 'dividend' | 'ai';
}

const { type = 'customs' } = Astro.props;
const items = SITE_CONFIG.affiliates[type] || SITE_CONFIG.affiliates.customs;
---

<div class="affiliate-section">
  {items.map((item) => (
    <div class="affiliate-card">
      <div class="affiliate-header">
        <span class="affiliate-badge">{item.badge}</span>
        <span class="affiliate-tag">추천 혜택</span>
      </div>
      <h3 class="affiliate-title">{item.title}</h3>
      <p class="affiliate-desc">{item.description}</p>
      <a href={item.url} target="_blank" rel="noopener noreferrer sponsored" class="affiliate-cta">
        {item.ctaText}
      </a>
      <p class="affiliate-disclosure">{item.disclosure}</p>
    </div>
  ))}
</div>

<style>
  .affiliate-section {
    margin: 1.5rem 0;
  }
  .affiliate-card {
    background: linear-gradient(135deg, #ecfdf5 0%, #f0fdf4 100%);
    border: 2px solid #6ee7b7;
    border-radius: 14px;
    padding: 1.5rem;
  }
  .affiliate-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }
  .affiliate-badge {
    background: #059669;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
  }
  .affiliate-tag {
    font-size: 0.78rem;
    font-weight: 700;
    color: #047857;
  }
  .affiliate-title {
    font-size: 1.2rem;
    color: #064e3b;
    margin-bottom: 0.45rem;
  }
  .affiliate-desc {
    font-size: 0.94rem;
    color: #065f46;
    margin-bottom: 1rem;
  }
  .affiliate-cta {
    display: inline-block;
    background: #059669;
    color: #fff !important;
    font-weight: 700;
    padding: 0.75rem 1.35rem;
    border-radius: 10px;
    text-decoration: none !important;
    transition: background 0.15s;
  }
  .affiliate-cta:hover {
    background: #047857;
  }
  .affiliate-disclosure {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: #047857;
    opacity: 0.85;
  }
</style>
